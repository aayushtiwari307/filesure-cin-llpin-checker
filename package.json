{
  "name": "filesure-cin-checker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.3.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^22.19.0",
    "jsdom": "^27.2.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  },
  "description": "Browser-only format checker for Indian company CINs and LLPINs.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.9"
  },
  "packageManager": "npm@11.21.3",
  "overrides": {
    "tinypool": "^2.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
